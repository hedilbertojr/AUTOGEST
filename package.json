{
  "name": "autogest",
  "version": "1.1.0",
  "private": true,
  "description": "Gestão local de oficina com SQLite",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node --test backend/tests/*.test.js",
    "check": "node scripts/check.cjs",
    "backup": "node scripts/backup.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:demo": "node scripts/build-demo.cjs",
    "test:demo": "node --test frontend/tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "prettier": "3.6.2"
  }
}
